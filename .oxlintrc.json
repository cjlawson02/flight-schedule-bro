{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "node", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "options": {
    "typeAware": true,
    "maxWarnings": 0
  },
  "ignorePatterns": [
    "coverage/**",
    "dist/**",
    ".wrangler/**",
    "cache/**",
    "cache-test/**",
    "test-cache/**"
  ]
}
