{
  "name": "flight-schedule-bro",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "src/cli/index.ts",
  "scripts": {
    "exec": "tsx src/cli/index.ts",
    "start": "tsx src/cli/index.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:tail": "wrangler tail",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fix": "oxlint --fix --deny-warnings && oxfmt",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm test",
    "prepare": "husky"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@types/cli-progress": "^3.11.6",
    "cli-progress": "^3.12.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "discord-api-types": "^0.38.50",
    "dotenv": "^18.0.0",
    "tslog": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260721.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.156.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "**/*.{ts,tsx,mts,cts,js,mjs,cjs}": "oxlint --fix --deny-warnings"
  }
}
